{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pipe-stress/schemas/experiment-manifest-1.0.json",
  "title": "Pipe stress pull-test experiment manifest",
  "type": "object",
  "required": ["schema_version", "experiment", "discovery", "filename_parser", "probe_aliases", "run_rules", "signal_schema", "feature_set"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment": {
      "type": "object",
      "required": ["experiment_id", "campaign_id", "pipe_id", "source_root"],
      "properties": {
        "experiment_id": {"type": "string", "minLength": 1},
        "campaign_id": {"type": "string", "minLength": 1},
        "pipe_id": {"type": "string", "minLength": 1},
        "source_root": {"type": "string", "minLength": 1}
      }
    },
    "signal_schema": {
      "type": "object",
      "required": ["axis_order", "columns_per_sensor", "accepted_column_counts", "minimum_rows"],
      "properties": {
        "axis_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "columns_per_sensor": {"type": "integer", "minimum": 1},
        "accepted_column_counts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "sample_rate_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "pull_speed_mps": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    }
  }
}
